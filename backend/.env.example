# SPECTRA-UPI backend configuration
# Copy to `.env` for local development. Never commit a real `.env`.
#
# Every feature works without paid services or external API keys. Optional
# integrations are clearly marked and can stay empty.

# ── Core ─────────────────────────────────────────────────────────────────
# Long random string. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# SQLite is the default and works with zero setup.
DATABASE_URL=sqlite:///./spectra_upi.db
# PostgreSQL example (requires psycopg2-binary, included in requirements):
# DATABASE_URL=postgresql://user:password@host:5432/spectra_upi

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# Salt for the reporter rate-limit hash. Change this in production.
# Raw IP addresses are never stored; only a salted hash.
REPORTER_HASH_SALT=change-me-to-a-random-value

# Set true only when running behind a trusted reverse proxy that sets
# X-Forwarded-For. Otherwise a client can spoof its IP.
TRUST_PROXY_HEADERS=false

# ── Public lookup behaviour ──────────────────────────────────────────────
# Seed clearly-labelled demo rows (values under .example and [DEMO DATA]).
DEMO_DATA_ENABLED=true

# ── Rate limiting (slowapi, in-memory) ───────────────────────────────────
RATE_LIMIT_ENABLED=true
LOOKUP_RATE_LIMIT=60/minute
REPORT_RATE_LIMIT=5/hour
DISPUTE_RATE_LIMIT=3/hour
API_KEY_RATE_LIMIT=60/minute

# ── CAPTCHA (Cloudflare Turnstile, free) ─────────────────────────────────
# Leave both empty for a fully offline setup. If TURNSTILE_SECRET_KEY is set,
# reports and disputes fail closed unless a valid token is supplied.
CAPTCHA_DISABLED=false
TURNSTILE_SECRET_KEY=

# ── Optional link reputation checks ──────────────────────────────────────
# Core lookup works offline when these are empty or when external checks are
# disabled. Results are cached in the database for EXTERNAL_CACHE_HOURS.
EXTERNAL_CHECKS_ENABLED=true
GOOGLE_SAFE_BROWSING_KEY=
VIRUSTOTAL_API_KEY=
OPENPHISH_FEED_URL=
# PhishTank's public CSV endpoint may change or require registration.
# PHISHTANK_FEED_URL=https://data.phishtank.com/data/online-valid.csv
PHISHTANK_FEED_URL=
EXTERNAL_CACHE_HOURS=24
VIRUSTOTAL_PER_MINUTE=4
VIRUSTOTAL_PER_DAY=500

# ── First moderator/admin (used only by scripts/create_admin.py) ─────────
# Do not set ADMIN_PASSWORD in a committed file. Prompt interactively instead.
# ADMIN_PASSWORD=
ADMIN_NAME=SPECTRA Admin
ADMIN_PHONE=
