# SPECTRA-UPI frontend configuration
# Copy to `.env` for local development.

# Leave empty when using the Vite dev proxy or the bundled nginx proxy.
# For a separately hosted API set the backend root, e.g.:
# VITE_API_URL=https://spectra-upi-backend.onrender.com
VITE_API_URL=

# Optional Cloudflare Turnstile site key (free). The matching secret belongs
# in the backend environment. Leave empty to hide the CAPTCHA widget.
VITE_TURNSTILE_SITE_KEY=
